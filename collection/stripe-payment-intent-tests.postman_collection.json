                  "pm.test(\"Request fails with 400\", function () {\r",
                  "    pm.response.to.have.status(400);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Error message contains 'Invalid currency'\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.error.param).to.eql(\"currency\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Error type is invalid_request_error\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.error.type).to.eql(\"invalid_request_error\");\r",
