    {
      "name": "01 Smoke",
      "item": [
        {
          "name": "GET Balance - Auth Smoke Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has balance object\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.object).to.eql(\"balance\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Confirms sandbox/test mode, not live\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.livemode).to.eql(false);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{stripe_secret_key}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/balance",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "balance"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Happy Path",
      "item": [
        {
          "name": "POST Create PaymentIntent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"PaymentIntent created with correct amount and currency\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.amount).to.eql(1000);\r",
                  "    pm.expect(jsonData.currency).to.eql(\"usd\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status is requires_payment_method\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.status).to.eql(\"requires_payment_method\");\r",
                  "});\r",
                  "\r",
                  "// Store the PaymentIntent ID so the next request (Confirm) can use it\r",
                  "const jsonData = pm.response.json();\r",
                  "pm.environment.set(\"payment_intent_id\", jsonData.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{stripe_secret_key}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "amount",
                  "value": "1000",
                  "type": "text",
                  "uuid": "88c454ca-98be-4ec4-8fc9-50d7ce47806c"
                },
                {
                  "key": "currency",
                  "value": "usd",
                  "type": "text",
                  "uuid": "3e2433cb-b113-4d86-9b17-e222eea9f075"
                },
