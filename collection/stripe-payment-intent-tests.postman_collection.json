        {
          "name": "Post Capture PaymentIntent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"PaymentIntent status is succeeded\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.status).to.eql(\"succeeded\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Amount received matches amount authorized\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.amount_received).to.eql(jsonData.amount);\r",
                  "});"
                ],
                "type": "text/javascript",
