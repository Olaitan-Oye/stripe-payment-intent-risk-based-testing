                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"PaymentIntent status is requires_capture\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.status).to.eql(\"requires_capture\");\r",
                  "});"
